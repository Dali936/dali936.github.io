{% if include.images %}
  <section class="home-gallery" aria-label="{{ include.title | default: 'visual highlights' }}">
    {% if include.title or include.subtitle %}
      <div class="home-gallery__header">
        {% if include.title %}
          <h2 class="home-gallery__title">{{ include.title }}</h2>
        {% endif %}
        {% if include.subtitle %}
          <p class="home-gallery__subtitle">{{ include.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
    <div class="home-gallery__grid">
      {% for item in include.images %}
        {% assign image_path = item.image | prepend: 'assets/img/' %}
        <div class="home-gallery__item">
          {%
            include figure.liquid
            path=image_path
            class="home-gallery__image z-depth-1"
            alt=item.alt
            zoomable=true
          %}
          {% if item.caption %}
            <div class="home-gallery__caption">{{ item.caption }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
{% endif %}
